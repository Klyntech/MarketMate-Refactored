# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Market Data APIs (Primary → Fallback) ──────────────────────────────────
BINANCE_API_KEY=your_binance_key          # primary (free public endpoint)
BINANCE_SECRET=your_binance_secret

ALPHA_VANTAGE_KEY=your_av_key            # fallback (free tier: 25 req/day)
TWELVE_DATA_KEY=your_twelve_data_key     # fallback #2 (free tier: 800 req/day)

# ─── Strategy ────────────────────────────────────────────────────────────────
PAIRS=XAUUSD                            # comma-separated, no spaces
MAX_TRADES_PER_DAY=5
MIN_RR=1.5
RISK_PER_TRADE_PCT=1.0
ACCOUNT_SIZE=10000

# ─── Simulated Execution ─────────────────────────────────────────────────────
SIM_LOT_SIZE=0.01                       # informational only — no real orders placed
SIM_EVAL_INTERVAL=600                   # seconds between trade evaluations (min 600)
SIM_EVAL_TF=15m                         # timeframe for SL/TP price checks

# ─── Sessions (UTC) ──────────────────────────────────────────────────────────
LONDON_OPEN=07:00
LONDON_CLOSE=12:00
NY_OPEN=12:00
NY_CLOSE=17:00

# ─── MongoDB (optional — bot runs without it) ────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=marketmate

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=production
DEBUG=false
LOG_LEVEL=INFO
DB_PATH=./db/marketmate.db
SCAN_INTERVAL=300                       # signal scan interval (seconds)
PORT=8000                               # Render injects this automatically

# ─── Security ────────────────────────────────────────────────────────────────
SESSION_SECRET=                          # Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=                            # Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=                          # Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ─── LLM Provider API Keys ──────────────────────────────────────────────────
GEMINI_API_KEY=                          # Primary: Google Gemini (free tier ~15 RPM, 1M context)
OPENROUTER_API_KEY=                      # Fallback 1: OpenRouter (one API, many models)
GROQ_API_KEY=                            # Fallback 2: Groq (ultra-fast, small context)
MISTRAL_API_KEY=                         # Optional: Mistral AI (clean writing, low hallucination)
TOGETHER_API_KEY=                        # Optional: Together AI (open-source models at scale)

# ─── LLM Rate Limits (client-side throttling) ───────────────────────────────
# These prevent hitting provider 429s by throttling requests BEFORE they're sent.
# Defaults are safe for free tiers. Increase if you have paid API keys.
GEMINI_RPM_LIMIT=12                      # Gemini free tier is ~15 RPM; we stay under
MATE_RATE_LIMIT_RPM=10                   # Per-user MATE query limit (each query = 1-8 LLM calls)
API_RATE_LIMIT_RPM=60                    # Global API rate limit (per IP)

# ─── Social Marketing Engine ────────────────────────────────────────────────
SOCIAL_ENGINE_ENABLED=true               # Master switch for social marketing engine
SOCIAL_REQUIRE_APPROVAL=true             # Require admin approval before publishing
SOCIAL_USE_AI=true                       # Use AI generation for marketing posts
SOCIAL_AUTO_GENERATE=false               # Auto-generate marketing posts on schedule

# Twitter/X (OAuth 1.0a)
TWITTER_API_KEY=                         # Twitter API Key
TWITTER_API_SECRET=                      # Twitter API Secret
TWITTER_ACCESS_TOKEN=                    # Twitter Access Token
TWITTER_ACCESS_SECRET=                   # Twitter Access Token Secret

# Facebook Page (Graph API)
FB_PAGE_ID=                              # Facebook Page ID
FB_ACCESS_TOKEN=                         # Facebook Page Access Token (long-lived)

# Instagram Business (Content Publishing API)
IG_ACCOUNT_ID=                           # Instagram Business Account ID
IG_ACCESS_TOKEN=                         # Instagram Graph API Token (via Facebook Page)

# Telegram (social broadcasts — separate from signal delivery)
SOCIAL_TELEGRAM_CHANNEL_ID=              # Telegram channel ID for marketing posts
