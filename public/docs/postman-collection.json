      ]
    },
    {
      "name": "Signals",
      "description": "Trading signal endpoints for real-time trade opportunities",
      "item": [
        {
          "name": "Get Trading Signals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/signals?symbol=BTC-USD&conviction=HIGH",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "signals"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTC-USD",
                  "description": "Filter by trading pair symbol (optional)"
                },
                {
                  "key": "conviction",
                  "value": "HIGH",
                  "description": "Filter by conviction level: HIGH, MEDIUM, LOW (optional)"
                }
              ]
            },
            "description": "Returns active trading signals filtered by optional parameters. Each signal includes entry zone, stop loss, take profit levels, risk/reward ratio, conviction level, SMC zone type, and confirmation method."
          },
          "response": [
            {
              "name": "High Conviction Signals",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/signals?conviction=HIGH",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "signals"],
                  "query": [
                    { "key": "conviction", "value": "HIGH" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "X-RateLimit-Limit", "value": "60" },
                { "key": "X-RateLimit-Remaining", "value": "57" }
              ],
              "body": "{\n  \"signals\": [\n    {\n      \"signal_id\": \"sig_550e8400\",\n      \"symbol\": \"BTC-USD\",\n      \"direction\": \"LONG\",\n      \"entry_zone\": { \"low\": 67850, \"high\": 68200, \"mid\": 68025 },\n      \"stop_loss\": 67100,\n      \"take_profit_1\": 69500,\n      \"take_profit_2\": 71000,\n      \"take_profit_3\": 72800,\n      \"risk_reward\": 3.2,\n      \"conviction\": \"HIGH\",\n      \"zone_type\": \"demand_zone\",\n      \"confirmation\": \"order_block\",\n      \"status\": \"ACTIVE\",\n      \"created_at\": \"2025-01-15T13:30:00.000Z\"\n    },\n    {\n      \"signal_id\": \"sig_7c9d0e20\",\n      \"symbol\": \"XAU-USD\",\n      \"direction\": \"LONG\",\n      \"entry_zone\": { \"low\": 2340, \"high\": 2348, \"mid\": 2344 },\n      \"stop_loss\": 2325,\n      \"take_profit_1\": 2375,\n      \"take_profit_2\": 2410,\n      \"take_profit_3\": 2450,\n      \"risk_reward\": 4.1,\n      \"conviction\": \"HIGH\",\n      \"zone_type\": \"liquidity_pool\",\n      \"confirmation\": \"break_of_structure\",\n      \"status\": \"ACTIVE\",\n      \"created_at\": \"2025-01-15T14:00:00.000Z\"\n    }\n  ],\n  \"count\": 2,\n  \"timestamp\": \"2025-01-15T14:30:00.000Z\"\n}"
            },
