{
  "info": {
    "name": "MarketMate API",
    "_postman_id": "marketmate-api-collection",
    "description": "Official MarketMate API collection. Access real-time market intelligence, trading signals, liquidity analysis, and historical data for cryptocurrency and forex markets.\n\n## Getting Started\n1. Replace `YOUR_API_KEY` in the collection variables with your actual API key\n2. Use the Verify endpoint to test your key\n3. Explore market data, signals, and liquidity endpoints\n\n## Authentication\nAll endpoints require a Bearer token (your API key) in the Authorization header.\n\n## Rate Limits\n- Free: 60 req/min\n- Pro: 300 req/min\n- Enterprise: 1000 req/min\n\n## Support\n- Docs: https://marketmate-website.onrender.com/developers\n- Email: api@marketmate.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "description": "API key verification and authentication endpoints",
      "item": [
        {
          "name": "Verify API Key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "verify"]
            },
            "description": "Validates the provided API key and returns its status and environment. Use this endpoint to test your API key before making data requests. No rate limit is applied to this endpoint."
          },
          "response": [
            {
              "name": "Valid Key",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/verify",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "verify"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"valid\": true,\n  \"environment\": \"production\"\n}"
            },
            {
              "name": "Invalid Key",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/verify",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "verify"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"valid\": false,\n  \"error\": \"Invalid or revoked API key\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Market Data",
      "description": "Real-time market state and liquidity analysis endpoints",
      "item": [
        {
          "name": "Get Market State",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/market-state?symbol=BTC-USD",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "market-state"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTC-USD",
                  "description": "Trading pair symbol (BTC-USD, ETH-USD, XAU-USD, SOL-USD, BNB-USD)"
                }
              ]
            },
            "description": "Returns the current market regime analysis for a given symbol, including trend direction, conviction level, volatility assessment, and key support/resistance levels. Data is updated every 15 minutes."
          },
          "response": [
            {
              "name": "BTC-USD Market State",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/market-state?symbol=BTC-USD",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "market-state"],
                  "query": [
                    { "key": "symbol", "value": "BTC-USD" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "X-RateLimit-Limit", "value": "60" },
                { "key": "X-RateLimit-Remaining", "value": "59" }
              ],
              "body": "{\n  \"symbol\": \"BTC-USD\",\n  \"regime\": \"trending_bullish\",\n  \"conviction\": 0.82,\n  \"volatility\": \"elevated\",\n  \"liquidity\": 0.76,\n  \"key_levels\": {\n    \"support\": [67850, 67200, 66500],\n    \"resistance\": [69500, 70200, 71500]\n  },\n  \"trend\": {\n    \"direction\": \"bullish\",\n    \"strength\": 0.74,\n    \"timeframe\": \"4H\"\n  },\n  \"updated_at\": \"2025-01-15T14:30:00.000Z\"\n}"
