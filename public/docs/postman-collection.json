    {
      "name": "Historical Data",
      "description": "Historical market data endpoints for backtesting and analysis",
      "item": [
        {
          "name": "Get Historical Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/historical?symbol=BTC-USD&hours=24&interval=1h",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "historical"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTC-USD",
                  "description": "Trading pair symbol (BTC-USD, ETH-USD, XAU-USD, SOL-USD, BNB-USD)"
                },
                {
                  "key": "hours",
                  "value": "24",
                  "description": "Number of hours of historical data (1-168, default: 24)"
                },
                {
                  "key": "interval",
                  "value": "1h",
                  "description": "Data interval: 5m, 15m, 30m, 1h, 4h, 1d (default: 1h)"
                }
              ]
            },
            "description": "Returns historical market regime data for a given symbol over a specified time range. Maximum lookback is 168 hours (7 days). Includes regime classification, conviction, volatility, and liquidity score at each interval."
          },
          "response": [
            {
              "name": "24h Historical Data",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/historical?symbol=BTC-USD&hours=24&interval=1h",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "historical"],
                  "query": [
                    { "key": "symbol", "value": "BTC-USD" },
                    { "key": "hours", "value": "24" },
                    { "key": "interval", "value": "1h" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "X-RateLimit-Limit", "value": "60" },
                { "key": "X-RateLimit-Remaining", "value": "56" }
              ],
              "body": "{\n  \"symbol\": \"BTC-USD\",\n  \"interval\": \"1h\",\n  \"data\": [\n    {\n      \"timestamp\": \"2025-01-15T14:00:00.000Z\",\n      \"regime\": \"trending_bullish\",\n      \"conviction\": 0.82,\n      \"volatility\": \"elevated\",\n      \"liquidity_score\": 0.76\n    },\n    {\n      \"timestamp\": \"2025-01-15T13:00:00.000Z\",\n      \"regime\": \"trending_bullish\",\n      \"conviction\": 0.78,\n      \"volatility\": \"elevated\",\n      \"liquidity_score\": 0.72\n    },\n    {\n      \"timestamp\": \"2025-01-15T12:00:00.000Z\",\n      \"regime\": \"ranging\",\n      \"conviction\": 0.45,\n      \"volatility\": \"normal\",\n      \"liquidity_score\": 0.65\n    }\n  ],\n  \"count\": 25,\n  \"timestamp\": \"2025-01-15T14:30:00.000Z\"\n}"
            }
          ]
        }
      ]
    },
