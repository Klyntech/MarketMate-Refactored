{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketMate Event Schemas",
  "version": "2.1.0",
  "description": "JSON Schema definitions for all MarketMate API events, WebSocket messages, and webhook payloads. Use these schemas to validate incoming data and auto-generate type-safe client code.",
  "schemas": {
    "MarketState": {
      "$id": "#/schemas/MarketState",
      "title": "MarketState",
      "description": "Represents the current market regime analysis for a trading pair, including trend direction, conviction, volatility, and key price levels.",
      "type": "object",
      "required": ["symbol", "regime", "conviction", "volatility", "liquidity", "key_levels", "trend", "updated_at"],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading pair symbol in QUOTE-BASE format",
          "pattern": "^[A-Z]{2,5}-[A-Z]{3}$",
          "examples": ["BTC-USD", "ETH-USD", "XAU-USD"]
        },
        "regime": {
          "type": "string",
          "description": "Current market regime classification based on Smart Money Concepts analysis",
          "enum": ["trending_bullish", "trending_bearish", "ranging", "volatile", "transitional"],
          "examples": ["trending_bullish"]
        },
        "conviction": {
          "type": "number",
          "description": "Conviction score for the current regime classification (0.0 = no conviction, 1.0 = maximum conviction)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.82]
        },
        "volatility": {
          "type": "string",
          "description": "Current volatility assessment based on ATR and Bollinger Band analysis",
          "enum": ["low", "normal", "elevated", "extreme"],
          "examples": ["elevated"]
        },
        "liquidity": {
          "type": "number",
          "description": "Overall liquidity score for the market (0.0 = illiquid, 1.0 = highly liquid)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.76]
        },
        "key_levels": {
          "type": "object",
          "description": "Key support and resistance price levels identified by the strategy engine",
          "required": ["support", "resistance"],
          "properties": {
            "support": {
              "type": "array",
              "description": "Support price levels ordered by strength (strongest first)",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 1,
              "maxItems": 5,
              "examples": [[67850, 67200, 66500]]
            },
            "resistance": {
              "type": "array",
              "description": "Resistance price levels ordered by proximity (closest first)",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 1,
              "maxItems": 5,
              "examples": [[69500, 70200, 71500]]
            }
          },
          "additionalProperties": false
        },
        "trend": {
          "type": "object",
          "description": "Current trend analysis including direction, strength, and primary timeframe",
          "required": ["direction", "strength", "timeframe"],
          "properties": {
            "direction": {
              "type": "string",
              "description": "Trend direction based on higher-timeframe structure",
              "enum": ["bullish", "bearish", "neutral"],
              "examples": ["bullish"]
            },
            "strength": {
              "type": "number",
              "description": "Trend strength score (0.0 = no trend, 1.0 = very strong trend)",
              "minimum": 0,
              "maximum": 1,
              "examples": [0.74]
            },
            "timeframe": {
              "type": "string",
              "description": "Primary timeframe for the trend analysis",
              "enum": ["1m", "5m", "15m", "30m", "1H", "4H", "1D", "1W"],
              "examples": ["4H"]
            }
          },
          "additionalProperties": false
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when this market state was last computed",
          "examples": ["2025-01-15T14:30:00.000Z"]
        }
      },
      "additionalProperties": false
    },
    "Signal": {
      "$id": "#/schemas/Signal",
      "title": "Signal",
      "description": "A trading signal generated by the MarketMate strategy engine. Includes entry zone, stop loss, take profit levels, risk/reward ratio, and Smart Money Concept confirmation details.",
      "type": "object",
      "required": ["signal_id", "symbol", "direction", "entry_zone", "stop_loss", "take_profit_1", "risk_reward", "conviction", "zone_type", "confirmation", "status", "created_at"],
      "properties": {
        "signal_id": {
          "type": "string",
          "description": "Unique signal identifier prefixed with 'sig_'",
          "pattern": "^sig_[a-f0-9]{8}$",
          "examples": ["sig_550e8400"]
        },
        "symbol": {
          "type": "string",
          "description": "Trading pair symbol",
          "pattern": "^[A-Z]{2,5}-[A-Z]{3}$",
          "examples": ["BTC-USD"]
        },
        "direction": {
          "type": "string",
          "description": "Trade direction",
          "enum": ["LONG", "SHORT"],
          "examples": ["LONG"]
        },
        "entry_zone": {
          "type": "object",
          "description": "Entry zone for the trade with low, high, and midpoint boundaries",
          "required": ["low", "high", "mid"],
          "properties": {
            "low": {
              "type": "number",
              "description": "Lower boundary of the entry zone",
              "exclusiveMinimum": 0,
              "examples": [67850]
            },
            "high": {
              "type": "number",
              "description": "Upper boundary of the entry zone",
              "exclusiveMinimum": 0,
              "examples": [68200]
            },
            "mid": {
              "type": "number",
              "description": "Midpoint of the entry zone",
              "exclusiveMinimum": 0,
              "examples": [68025]
            }
          },
          "additionalProperties": false
        },
        "stop_loss": {
          "type": "number",
          "description": "Stop loss price level",
          "exclusiveMinimum": 0,
          "examples": [67100]
        },
        "take_profit_1": {
          "type": "number",
          "description": "First take profit level (conservative target)",
          "exclusiveMinimum": 0,
          "examples": [69500]
        },
        "take_profit_2": {
          "type": ["number", "null"],
          "description": "Second take profit level (moderate target). May be null for lower-conviction signals.",
          "exclusiveMinimum": 0,
          "examples": [71000, null]
        },
        "take_profit_3": {
          "type": ["number", "null"],
          "description": "Third take profit level (aggressive target). May be null for lower-conviction signals.",
          "exclusiveMinimum": 0,
          "examples": [72800, null]
        },
        "risk_reward": {
          "type": "number",
          "description": "Risk-to-reward ratio calculated from entry midpoint to TP1 vs stop loss",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "examples": [3.2]
        },
        "conviction": {
          "type": "string",
          "description": "Signal conviction level based on the number and quality of confirmations",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "examples": ["HIGH"]
        },
        "zone_type": {
          "type": "string",
          "description": "Smart Money Concept zone type that originated this signal",
          "enum": ["demand_zone", "supply_zone", "liquidity_pool", "breaker_block", "mitigation_block"],
          "examples": ["demand_zone"]
        },
        "confirmation": {
          "type": "string",
          "description": "Primary confirmation method that validated the zone",
          "enum": ["order_block", "fair_value_gap", "break_of_structure", "change_of_character", "liquidity_sweep"],
          "examples": ["order_block"]
        },
        "status": {
          "type": "string",
          "description": "Current lifecycle status of the signal",
          "enum": ["ACTIVE", "TRIGGERED", "EXPIRED", "CANCELLED"],
          "examples": ["ACTIVE"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the signal was generated",
          "examples": ["2025-01-15T13:30:00.000Z"]
        }
      },
      "additionalProperties": false
    },
    "SignalsResponse": {
      "$id": "#/schemas/SignalsResponse",
      "title": "SignalsResponse",
      "description": "Response envelope for the signals endpoint containing an array of signals with metadata",
      "type": "object",
      "required": ["signals", "count", "timestamp"],
      "properties": {
        "signals": {
          "type": "array",
          "description": "Array of trading signals matching the query filters",
          "items": {
            "$ref": "#/schemas/Signal"
          }
        },
        "count": {
          "type": "integer",
          "description": "Number of signals returned in this response",
          "minimum": 0,
          "examples": [3]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the response was generated",
          "examples": ["2025-01-15T14:30:00.000Z"]
        }
      },
      "additionalProperties": false
    },
    "LiquidityPool": {
      "$id": "#/schemas/LiquidityPool",
      "title": "LiquidityPool",
      "description": "A single liquidity pool at a specific price level",
      "type": "object",
      "required": ["level", "type", "strength", "volume"],
      "properties": {
        "level": {
          "type": "number",
          "description": "Price level of the liquidity pool",
          "exclusiveMinimum": 0,
          "examples": [67850]
        },
        "type": {
          "type": "string",
          "description": "Type of liquidity pool: demand (buy-side) or supply (sell-side)",
          "enum": ["demand", "supply"],
          "examples": ["demand"]
        },
        "strength": {
          "type": "number",
          "description": "Pool strength score (0.0 = weak, 1.0 = very strong)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.85]
        },
        "volume": {
          "type": "string",
          "description": "Estimated volume at this liquidity level with unit",
          "examples": ["24.5 BTC"]
        }
      },
      "additionalProperties": false
    },
    "LiquiditySweep": {
      "$id": "#/schemas/LiquiditySweep",
      "title": "LiquiditySweep",
      "description": "A liquidity sweep event where price moved beyond a key level to trigger stop orders",
      "type": "object",
      "required": ["level", "direction", "swept_at", "volume"],
      "properties": {
        "level": {
          "type": "number",
          "description": "Price level that was swept through",
          "exclusiveMinimum": 0,
          "examples": [67100]
        },
        "direction": {
          "type": "string",
          "description": "Direction of the sweep: bullish (swept sell stops below) or bearish (swept buy stops above)",
          "enum": ["bullish", "bearish"],
          "examples": ["bearish"]
        },
        "swept_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the sweep occurred",
          "examples": ["2025-01-14T14:30:00.000Z"]
        },
        "volume": {
          "type": "string",
          "description": "Volume involved in the sweep event with unit",
          "examples": ["45.2 BTC"]
        }
      },
      "additionalProperties": false
    },
    "LiquidityAnalysis": {
      "$id": "#/schemas/LiquidityAnalysis",
      "title": "LiquidityAnalysis",
      "description": "Complete liquidity analysis for a trading pair including pools and recent sweeps",
      "type": "object",
      "required": ["symbol", "score", "pools", "sweeps", "updated_at"],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading pair symbol",
          "pattern": "^[A-Z]{2,5}-[A-Z]{3}$",
          "examples": ["BTC-USD"]
        },
        "score": {
          "type": "number",
          "description": "Overall liquidity score (0.0 = illiquid, 1.0 = highly liquid)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.76]
        },
        "pools": {
          "type": "array",
          "description": "Liquidity pools identified at key price levels",
          "items": {
            "$ref": "#/schemas/LiquidityPool"
          }
        },
        "sweeps": {
          "type": "array",
          "description": "Recent liquidity sweep events (last 48 hours)",
          "items": {
            "$ref": "#/schemas/LiquiditySweep"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when this analysis was last updated",
          "examples": ["2025-01-15T14:30:00.000Z"]
        }
      },
      "additionalProperties": false
    },
    "HistoricalDataPoint": {
      "$id": "#/schemas/HistoricalDataPoint",
      "title": "HistoricalDataPoint",
      "description": "A single data point in the historical market data series",
      "type": "object",
      "required": ["timestamp", "regime", "conviction", "volatility", "liquidity_score"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of this data point",
          "examples": ["2025-01-15T13:00:00.000Z"]
        },
        "regime": {
          "type": "string",
          "description": "Market regime classification at this point in time",
          "enum": ["trending_bullish", "trending_bearish", "ranging", "volatile"],
          "examples": ["trending_bullish"]
        },
        "conviction": {
          "type": "number",
          "description": "Regime conviction score (0.0 - 1.0)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.78]
        },
        "volatility": {
          "type": "string",
          "description": "Volatility level at this point",
          "enum": ["low", "normal", "elevated", "extreme"],
          "examples": ["elevated"]
        },
        "liquidity_score": {
          "type": "number",
          "description": "Liquidity score (0.0 - 1.0)",
          "minimum": 0,
          "maximum": 1,
          "examples": [0.72]
        }
      },
      "additionalProperties": false
    },
    "HistoricalResponse": {
      "$id": "#/schemas/HistoricalResponse",
      "title": "HistoricalResponse",
      "description": "Response envelope for the historical data endpoint",
      "type": "object",
      "required": ["symbol", "interval", "data", "count", "timestamp"],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading pair symbol",
          "pattern": "^[A-Z]{2,5}-[A-Z]{3}$",
          "examples": ["BTC-USD"]
        },
        "interval": {
          "type": "string",
          "description": "Data interval used for the historical series",
          "enum": ["5m", "15m", "30m", "1h", "4h", "1d"],
          "examples": ["1h"]
        },
        "data": {
          "type": "array",
          "description": "Array of historical data points in chronological order",
          "items": {
            "$ref": "#/schemas/HistoricalDataPoint"
          }
        },
        "count": {
          "type": "integer",
          "description": "Number of data points returned",
          "minimum": 0,
          "examples": [25]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the response was generated",
          "examples": ["2025-01-15T14:30:00.000Z"]
        }
      },
      "additionalProperties": false
    },
    "VerifyResponse": {
      "$id": "#/schemas/VerifyResponse",
      "title": "VerifyResponse",
      "description": "Response from the API key verification endpoint",
      "type": "object",
      "required": ["valid"],
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "Whether the provided API key is valid and active",
          "examples": [true]
        },
        "environment": {
          "type": "string",
          "description": "The environment this API key is valid for (only present when valid is true)",
          "enum": ["production", "sandbox"],
          "examples": ["production"]
        },
        "error": {
          "type": "string",
          "description": "Error description (only present when valid is false)",
          "examples": ["Invalid or revoked API key"]
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "valid": { "const": true } }
      },
      "then": {
        "required": ["environment"]
      },
      "else": {
        "required": ["error"]
      }
    },
    "WebSocketEvent": {
      "$id": "#/schemas/WebSocketEvent",
      "title": "WebSocketEvent",
      "description": "Generic wrapper for all WebSocket events emitted by the MarketMate real-time feed",
      "type": "object",
      "required": ["event", "data", "timestamp"],
      "properties": {
        "event": {
          "type": "string",
          "description": "Event type identifier",
          "enum": [
            "market_state:update",
            "signal:new",
            "signal:update",
            "liquidity:update",
            "liquidity:sweep",
            "historical:tick",
            "connection:established",
            "connection:ping",
            "connection:pong",
            "subscription:confirmed",
            "subscription:rejected",
            "error"
          ],
          "examples": ["signal:new"]
        },
        "data": {
          "description": "Event payload. The schema depends on the event type.",
          "oneOf": [
            {
              "title": "MarketStateUpdate",
              "description": "Payload for market_state:update events",
              "$ref": "#/schemas/MarketState"
            },
            {
              "title": "SignalEvent",
              "description": "Payload for signal:new and signal:update events",
              "$ref": "#/schemas/Signal"
            },
            {
              "title": "LiquidityUpdate",
              "description": "Payload for liquidity:update events",
              "$ref": "#/schemas/LiquidityAnalysis"
            },
            {
              "title": "LiquiditySweepEvent",
              "description": "Payload for liquidity:sweep events",
              "$ref": "#/schemas/LiquiditySweep"
            },
            {
              "title": "HistoricalTick",
              "description": "Payload for historical:tick events",
              "$ref": "#/schemas/HistoricalDataPoint"
            },
            {
              "title": "ConnectionEvent",
              "description": "Payload for connection events",
              "type": "object",
              "properties": {
                "connection_id": {
                  "type": "string",
                  "description": "Unique connection identifier"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable message"
                }
              }
            },
            {
              "title": "SubscriptionEvent",
              "description": "Payload for subscription events",
              "type": "object",
              "properties": {
                "channels": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of subscribed channels"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable message"
                }
              }
            },
            {
              "title": "ErrorEvent",
              "description": "Payload for error events",
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Error code"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable error message"
                }
              }
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the event was emitted",
          "examples": ["2025-01-15T14:30:00.000Z"]
        },
        "sequence": {
          "type": "integer",
          "description": "Monotonically increasing sequence number for event ordering",
          "minimum": 0,
          "examples": [12345]
        }
      },
      "additionalProperties": false
    },
    "WebSocketSubscribeMessage": {
      "$id": "#/schemas/WebSocketSubscribeMessage",
      "title": "WebSocketSubscribeMessage",
      "description": "Client-to-server message for subscribing to WebSocket channels",
      "type": "object",
      "required": ["action", "channels"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Subscription action",
          "enum": ["subscribe", "unsubscribe"],
          "examples": ["subscribe"]
        },
        "channels": {
          "type": "array",
          "description": "List of channels to subscribe to or unsubscribe from",
          "items": {
            "type": "string",
            "enum": [
              "market_state:BTC-USD",
              "market_state:ETH-USD",
              "market_state:XAU-USD",
              "signals",
              "signals:BTC-USD",
              "signals:ETH-USD",
              "liquidity:BTC-USD",
              "liquidity:ETH-USD",
              "historical:BTC-USD",
              "historical:ETH-USD"
            ]
          },
          "minItems": 1,
          "examples": [["signals", "market_state:BTC-USD"]]
        }
      },
      "additionalProperties": false
    },
    "WebhookPayload": {
      "$id": "#/schemas/WebhookPayload",
      "title": "WebhookPayload",
      "description": "Payload delivered to configured webhook endpoints when events occur",
      "type": "object",
      "required": ["id", "event", "data", "timestamp", "delivery_attempt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique delivery identifier for idempotency",
          "pattern": "^wh_[a-f0-9]{16}$",
          "examples": ["wh_550e8400e29b41d4"]
        },
        "event": {
          "type": "string",
          "description": "Event type that triggered this webhook delivery",
          "enum": [
            "signal:new",
            "signal:update",
            "signal:expired",
            "market_state:change",
            "liquidity:sweep"
          ],
          "examples": ["signal:new"]
        },
        "data": {
          "description": "Event-specific payload data",
          "oneOf": [
            {
              "title": "SignalPayload",
              "$ref": "#/schemas/Signal"
            },
            {
              "title": "MarketStatePayload",
              "$ref": "#/schemas/MarketState"
            },
            {
              "title": "LiquiditySweepPayload",
              "$ref": "#/schemas/LiquiditySweep"
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the event occurred",
          "examples": ["2025-01-15T14:30:00.000Z"]
        },
        "delivery_attempt": {
          "type": "integer",
          "description": "Current delivery attempt number (starts at 1)",
          "minimum": 1,
          "maximum": 5,
          "examples": [1]
        },
        "webhook_config_id": {
          "type": "string",
          "description": "ID of the webhook configuration that triggered this delivery",
          "examples": ["cfg_abc123"]
        }
      },
      "additionalProperties": false
    },
    "ErrorResponse": {
      "$id": "#/schemas/ErrorResponse",
      "title": "ErrorResponse",
      "description": "Standard error response returned by all MarketMate API endpoints on failure",
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": {
          "type": "string",
          "description": "Machine-readable error type identifier",
          "enum": [
            "Unauthorized",
            "RateLimitExceeded",
            "InternalServerError",
            "BadRequest",
            "NotFound",
            "Forbidden"
          ],
          "examples": ["Unauthorized"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message with actionable guidance",
          "examples": ["API key required. Include Authorization: Bearer <your-api-key> header."]
        },
        "retry_after": {
          "type": "integer",
          "description": "Seconds until the rate limit resets (only present for RateLimitExceeded errors)",
          "minimum": 1,
          "examples": [60]
        },
        "request_id": {
          "type": "string",
          "description": "Unique request identifier for debugging and support (only present for server errors)",
          "examples": ["req_550e8400e29b41d4a016"]
        }
      },
      "additionalProperties": false
    }
  }
}